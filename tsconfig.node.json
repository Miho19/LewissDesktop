{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "./src/**/*", "./src/preload/**/*", "./test/**/*", "./test/**/*.json", "./src/**/*.ts", "./src/shared/types/env.d.ts"],
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": "./",
    "declaration": true,
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@main/*": ["./src/main/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "moduleResolution": "bundler"
  },
  "exclude": [
    "dist", "node_modules"
  ]
}
