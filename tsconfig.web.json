{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "./src/renderer/src/env.d.ts",
    "./src/renderer/src/**/*",
    "./src/renderer/src/**/*.tsx",
    "./src/preload/*.d.ts",
    "./test/**/*",
    "./src/**/*.ts",
    "./src/shared/types/env.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": "./",
    "jsx": "react-jsx",
    "paths": {
      "@main/*": ["./src/main/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
